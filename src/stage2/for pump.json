{
  "timestamp_col": "timestamp",
  "segment_col": "segment",
  "gap_multiplier": 3.0,
  "name": "pump",
  "work_dir": "out/pump",
  "input_path": "data_clean Pump.csv",
  "drop_columns": ["Unnamed: 0"],
  "dup_policy": "drop",
  "missing_policy": "interpolate",
  "gt_mode": "intervals",
  "gt_col": "ground_truth",
  "label_col_raw": "machine_status",
  "label_map": {"NORMAL": 0, "RECOVERING": 1, "BROKEN": 1},
  "protect_cols": ["machine_status"],
  "window_seconds": 1800,
  "stride_seconds": 1800,
  "gap_threshold_seconds": 180,
  "exclude_cols": ["machine_status"],
  "split": {
    "mode": "events",
    "test_events": 3,
    "lead_hours": 48,
    "val_ratio": 0.15,
    "test_ratio": 0.20,
    "gap_windows": 20
  }
}